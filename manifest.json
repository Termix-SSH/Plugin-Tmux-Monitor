{
  "id": "tmux-monitor",
  "name": "Tmux Monitor",
  "version": "1.1.0",
  "description": "Browse and control tmux sessions, windows and panes across your hosts.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Tmux-Monitor",
  "docs": "https://docs.termix.site/plugins/tmux-monitor",
  "video": "https://www.youtube.com/watch?v=d0PwHYi1hDM",
  "category": "Terminal",
  "icon": "Layers",
  "features": [
    "Every host's tmux sessions in one place",
    "Live pane previews",
    "Resource use for each session",
    "Search across every pane",
    "Create, rename, split and kill sessions, windows and panes",
    "Attach a terminal in one click",
    "A tmux panel beside any SSH terminal to attach and switch sessions"
  ],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface"
  ],
  "provides": [
    {
      "service": "tmux.sessions",
      "version": "1.0.0",
      "permission": "tmux-monitor.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "tmux_monitor",
        "titleKey": "nav.tmuxMonitor",
        "icon": "Layers",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableTmuxMonitor",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": [
          {
            "key": "mouseEnabled",
            "type": "boolean",
            "labelKey": "settings.host.mouseEnabled.label",
            "descriptionKey": "settings.host.mouseEnabled.description",
            "default": true
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableTmuxMonitor"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 300
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "hostCapability": {
      "key": "enableTmuxMonitor",
      "labelKey": "hosts.tabTmuxMonitor",
      "editorTab": "tmux-monitor"
    },
    "uses": ["terminal.view", "terminal.open"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
