{
  "id": "tmux-monitor",
  "name": "Tmux Monitor",
  "version": "1.2.0",
  "description": "Browse and control tmux sessions, windows and panes across your hosts.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Tmux-Monitor",
  "docs": "https://docs.termix.site/plugins/tmux-monitor",
  "video": "https://www.youtube.com/watch?v=KbxM1W0VaYY",
  "category": "Terminal",
  "icon": "Layers",
  "features": [
    "Every host's tmux sessions in one place",
    "Live pane previews",
    "Resource use for each session",
    "Search across every pane",
    "Create, rename, split and kill sessions, windows and panes",
    "Attach a terminal in one click",
    "A tmux panel beside any SSH terminal to attach and switch sessions"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface",
    "operations:provide"
  ],
  "provides": [
    {
      "service": "tmux.sessions",
      "version": "1.0.0",
      "permission": "tmux-monitor.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "tmux_monitor",
        "titleKey": "nav.tmuxMonitor",
        "icon": "Layers",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableTmuxMonitor",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": [
          {
            "key": "mouseEnabled",
            "type": "boolean",
            "labelKey": "settings.host.mouseEnabled.label",
            "descriptionKey": "settings.host.mouseEnabled.description",
            "default": true
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableTmuxMonitor"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 300
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "hostCapability": {
      "key": "enableTmuxMonitor",
      "labelKey": "hosts.tabTmuxMonitor",
      "editorTab": "tmux-monitor"
    },
    "uses": ["terminal.view", "terminal.open"],
    "operations": {
      "actions": [
        {
          "id": "tmux-monitor.list-sessions",
          "titleKey": "operations.list.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableTmuxMonitor": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "tmux-monitor.session-count",
          "titleKey": "operations.count.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableTmuxMonitor": true
            }
          },
          "surfaces": {
            "palette": false
          }
        },
        {
          "id": "tmux-monitor.kill-session",
          "titleKey": "operations.kill.title",
          "icon": "X",
          "scope": "resource",
          "resource": "tmux-monitor.session",
          "risk": "destructive",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableTmuxMonitor": true
            }
          }
        }
      ],
      "resources": [
        {
          "id": "tmux-monitor.session",
          "titleKey": "operations.sessions.title",
          "icon": "SquareTerminal",
          "list": "tmux-monitor.list-sessions",
          "key": "name",
          "name": "name",
          "status": "state",
          "tab": "tmux_monitor",
          "columns": [
            {
              "key": "clients",
              "titleKey": "operations.sessions.clients"
            },
            {
              "key": "lastActivity",
              "titleKey": "operations.sessions.activity",
              "type": "time"
            }
          ]
        }
      ],
      "signals": [
        {
          "id": "tmux-monitor.sessions",
          "titleKey": "operations.sessions.title",
          "read": "tmux-monitor.session-count",
          "scope": "host",
          "kind": "count",
          "refreshSec": 120
        }
      ]
    },
    "dashboardCards": [
      {
        "id": "tmux-hosts",
        "titleKey": "card.title",
        "icon": "Layers"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
